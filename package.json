{
  "name": "realms-unwritten",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:client": "cd apps/client && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "build": "cd apps/client && bun run build",
    "check": "bunx tsc --noEmit -p apps/client/tsconfig.json && bunx tsc --noEmit -p apps/server/tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0"
  }
}
